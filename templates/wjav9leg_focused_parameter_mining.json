    },
    {
      "variant": "delta_signal",
      "description": "One-day delta of the price-derived gap",
      "signal": "rank(ts_rank(ts_delta({gap}, 1), {field_window})) * rank(1 - ts_rank(returns, {return_window}))"
    },
    {
      "variant": "zscore_signal",
